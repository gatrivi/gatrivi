{
  "name": "Gatrivi CRM",
  "short_name": "Gatrivi CRM",
  "description": "CRM comercial y captura rápida de prospectos para TMM.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f5f4",
  "theme_color": "#171814",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/crm-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/crm-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/t/gatrivi/prospects",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
